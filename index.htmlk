<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Verification</title>
    <style>
        /* Reset & General Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #111;
        }

        /* Main Website Background Content */
        .main-content {
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #2c3e50, #000000);
            color: #fff;
            text-align: center;
            padding: 20px;
        }

        .main-content h1 {
            font-size: 3rem;
            opacity: 0.3;
        }

        /* Full Background Blur (Backdrop Overlay) */
        .popup-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8); /* Dark black tint */
            backdrop-filter: blur(8px); /* Background blur effect */
            -webkit-backdrop-filter: blur(8px); /* Safari support */
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999;
            padding: 15px;
        }

        /* Popup Box */
        .popup-box {
            background: #ffffff;
            color: #222;
            padding: 40px 30px;
            border-radius: 16px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            max-width: 450px;
            width: 100%;
        }

        .popup-box h2 {
            font-size: 1.6rem;
            color: #333;
            margin-bottom: 15px;
            line-height: 1.4;
        }

        /* Payout wala text line - Zoom In / Zoom Out (Pulse Animation) */
        .highlight-text {
            font-size: 1.4rem;
            color: #e74c3c;
            font-weight: bold;
            margin-top: 10px;
            display: inline-block;
            animation: zoomPulse 1.5s infinite ease-in-out;
        }

        /* Zoom In / Zoom Out Keyframes Animation */
        @keyframes zoomPulse {
            0% {
                transform: scale(1);
            }
            50% {
                transform: scale(1.08);
            }
            100% {
                transform: scale(1);
            }
        }

        /* Mobile View Adjustments */
        @media (max-width: 480px) {
            .popup-box {
                padding: 30px 20px;
            }
            .popup-box h2 {
                font-size: 1.3rem;
            }
            .highlight-text {
                font-size: 1.1rem;
            }
        }
    </style>
</head>
<body>

    <!-- Main Website Background -->
    <div class="main-content">
        <h1>Welcome to Our Website</h1>
    </div>

    <!-- Full Background Blur with Notice Popup -->
    <div class="popup-overlay">
        <div class="popup-box">
            <h2>Your account is not verified, please get it verified.</h2>
            <div class="highlight-text">Your payout is on hold</div>
        </div>
    </div>

</body>
</html>
